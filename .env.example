# Firebase Configuration (Realtime Database & Web Analytics)
# Dapatkan kredensial dari Firebase Console > Project Settings > General > Your Apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# In-App Bug Reporter & Feedback Dispatch (Web3Forms API)
# Daftar gratis di https://web3forms.com/ untuk mendapatkan access key (250 pengiriman/bulan gratis)
VITE_ADMIN_REPORT_EMAIL=developer@example.com
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
